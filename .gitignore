# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.expo-*-check*/
.expo-export-*/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# Firebase / Google services (never commit)
google-services.json
GoogleService-Info.plist

# Android signing
*.keystore

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Build outputs
*.apk
*.aab
