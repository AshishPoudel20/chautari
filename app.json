{
  "expo": {
    "name": "Chautari",
    "slug": "chautari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Chautari to access your photos to attach images.",
        "NSCameraUsageDescription": "Chautari needs camera access so you can take photos for posts and your profile."
      }
    },
    "android": {
      "package": "com.ashishpoudeltete.chautari",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B7A6B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#B5302E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chautari to access your photos to attach images.",
          "cameraPermission": "Chautari needs camera access so you can take photos for posts and your profile."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B7A6B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c0f583d9-e0f1-42ff-92c1-43c599a87040"
      }
    },
    "owner": "ashishpoudeltete"
  }
}
