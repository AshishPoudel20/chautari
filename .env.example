# Supabase — copy to .env (never commit .env)
# Dashboard → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mock OTP in UI (default). Profile saved to Supabase on onboarding finish. Set false for real SMS.
EXPO_PUBLIC_AUTH_DEV_MODE=true

# Direct Postgres URL — for migrations/scripts only (Dashboard → Database → Connection string → URI)
# SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# NEVER add service_role to the mobile app. Use only in server scripts / SQL Editor / Edge Functions.
